<section id="work" class="work">
  <article class="feature">
    <div class="image-group">
      <a href="/projects/aerospace-technology"><img src="/images/portfolio/eurofighters.jpg" alt="Aerospace photography" loading="lazy" /></a>
      <div class="thumbs"><img src="/images/portfolio/f15.jpg" alt="Aviation photography" /><img src="/images/portfolio/schipol.jpg" alt="Airport photography" /></div>
    </div>
    <div class="copy"><p class="label">Aerospace & advanced engineering</p><h2>Communicating complex capability clearly.</h2><p>Photography and film that helps technical organisations explain innovation, expertise and the value of what they do.</p></div>
  </article>

  <article class="feature reverse">
    <div class="copy"><p class="label">Industrial & commercial</p><h2>Showing the expertise behind the process.</h2><p>Authentic imagery of facilities, products and people that reveals the skill, precision and experience behind successful businesses.</p></div>
    <div class="image-group"><img src="/images/portfolio/dewaltsaw.jpg" alt="Industrial product photography" loading="lazy" /><div class="thumbs"><img src="/images/portfolio/rallycar.jpg" alt="Commercial photography" /><img src="/images/portfolio/pulsarfashion.jpg" alt="Product photography" /></div></div>
  </article>

  <article class="feature">
    <div class="image-group"><img src="/images/portfolio/amy.jpg" alt="Corporate portrait photography" loading="lazy" /></div>
    <div class="copy"><p class="label">Corporate storytelling</p><h2>Putting people into the bigger picture.</h2><p>Portraits and workplace photography that support brands, websites and communications without resorting to staged corporate clichés.</p></div>
  </article>
</section>

<style>
.work { padding: 3.5rem 0; }
.feature { display:grid; grid-template-columns:1.8fr .7fr; gap:3rem; align-items:center; margin-bottom:5rem; }
.reverse { grid-template-columns:.7fr 1.8fr; }
.image-group img { width:100%; display:block; object-fit:cover; transition:transform .4s ease; }
.image-group a img:hover { transform:scale(1.02); }
.image-group > img, .image-group > a img { aspect-ratio:5/3; }
.thumbs { display:grid; grid-template-columns:repeat(2,1fr); gap:.8rem; margin-top:.8rem; }
.thumbs img { aspect-ratio:1/1; }
h2 { font-size:clamp(1.6rem,2.5vw,2.5rem); }
.copy p { font-size:.95rem; }
@media(max-width:800px){.feature,.reverse{display:block}.copy{margin-top:2rem}}
</style>
