---
---

<section id="work" class="work">
  <article class="feature">
    <div class="image-group">
      <a href="#aerospace" class="lightbox-link"><img src="/images/portfolio/eurofighters.jpg" alt="Aerospace photography" loading="lazy" /></a>
      <div class="thumbs">
        <a href="#f15"><img src="/images/portfolio/f15.jpg" alt="Aviation photography" loading="lazy" /></a>
        <a href="#schipol"><img src="/images/portfolio/schipol.jpg" alt="Airport photography" loading="lazy" /></a>
      </div>
    </div>
    <div class="copy">
      <p class="label">Aerospace & Technology</p>
      <h2>Communicating complex industries clearly.</h2>
      <p>From aviation to engineering, I create imagery that helps organisations explain capability, innovation and expertise.</p>
    </div>
  </article>

  <article class="feature people reverse">
    <div class="image-group">
      <a href="#amy"><img src="/images/portfolio/amy.jpg" alt="Corporate portrait photography" loading="lazy" /></a>
      <div class="thumbs">
        <a href="#girlportrait"><img src="/images/portfolio/girlportrait.jpg" alt="Portrait photography" loading="lazy" /></a>
        <a href="#headshot"><img src="/images/portfolio/headshot.jpg" alt="Corporate headshot photography" loading="lazy" /></a>
      </div>
    </div>
    <div class="copy">
      <p class="label">People & Culture</p>
      <h2>Putting real people at the heart of organisations.</h2>
      <p>Authentic workplace photography and corporate headshots that build trust, strengthen brands and show the human side of a business.</p>
    </div>
  </article>

  <article class="feature">
    <div class="image-group">
      <a href="#dewaltsaw"><img src="/images/portfolio/dewaltsaw.jpg" alt="Product photography" loading="lazy" /></a>
      <div class="thumbs">
        <a href="#pulsar"><img src="/images/portfolio/pulsarfashion.jpg" alt="Fashion photography" loading="lazy" /></a>
        <a href="#rally"><img src="/images/portfolio/rallycar.jpg" alt="Automotive photography" loading="lazy" /></a>
      </div>
    </div>
    <div class="copy">
      <p class="label">Brands & Products</p>
      <h2>Images that make products memorable.</h2>
      <p>Commercial photography created to help brands communicate quality, performance and personality.</p>
    </div>
  </article>
</section>

{[
  ['aerospace','eurofighters.jpg'],['f15','f15.jpg'],['schipol','schipol.jpg'],['amy','amy.jpg'],['girlportrait','girlportrait.jpg'],['headshot','headshot.jpg'],['dewaltsaw','dewaltsaw.jpg'],['pulsar','pulsarfashion.jpg'],['rally','rallycar.jpg']
].map(([id,file]) => <div id={id} class="modal"><a href="#work" class="close">×</a><img src={`/images/portfolio/${file}`} alt="" /></div>)}

<style>
.work { padding: 3.5rem 0; }
.feature { display:grid; grid-template-columns:1.8fr .7fr; gap:3rem; align-items:center; margin-bottom:4rem; }
.people { grid-template-columns:2fr .65fr; }
.reverse .image-group { order:2; }
.image-group img { width:100%; display:block; object-fit:cover; }
.image-group > a img { aspect-ratio:5/3; }
.thumbs { display:grid; grid-template-columns:repeat(2,1fr); gap:.8rem; margin-top:.8rem; }
.thumbs img { aspect-ratio:1/1; }
.label { text-transform:uppercase; letter-spacing:.12em; font-size:.7rem; }
h2 { font-size:clamp(1.6rem,2.5vw,2.5rem); }
.copy p { font-size:.95rem; }
.modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,.9); z-index:100; padding:3rem; align-items:center; justify-content:center; }
.modal:target { display:flex; }
.modal img { max-width:95vw; max-height:90vh; object-fit:contain; }
.close { position:absolute; top:1rem; right:2rem; color:white; font-size:3rem; }
@media(max-width:800px){.feature,.people{display:block}.reverse .image-group{order:initial}.copy{margin-top:2rem}}
</style>
