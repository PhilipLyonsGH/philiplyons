---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Introduction from '../components/Introduction.astro';
import AboutPhilip from '../components/AboutPhilip.astro';
import Capabilities from '../components/Capabilities.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Services from '../components/Services.astro';
import Footer from '../components/Footer.astro';

const title = 'Philip Lyons | Commercial Photographer & Filmmaker';
const description = 'Commercial photography and filmmaking for organisations that want to communicate clearly, authentically and with credibility.';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <Header />
    <Hero />
    <main>
      <Introduction />
      <AboutPhilip />
      <Capabilities />
      <PortfolioGrid />
      <CaseStudies />
      <Services />
    </main>
    <Footer />
  </body>
</html>