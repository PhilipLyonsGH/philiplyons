---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Introduction from '../components/Introduction.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import Services from '../components/Services.astro';
import Footer from '../components/Footer.astro';

const title = 'Phil Lyons | Commercial Photographer & Filmmaker';
---

<html lang="en">
  <head>
    <title>{title}</title>
    <meta name="description" content="Commercial photography and filmmaking for organisations that want to communicate clearly and authentically." />
  </head>
  <body>
    <Header />
    <Hero />
    <main>
      <Introduction />
      <PortfolioGrid />
      <Services />
    </main>
    <Footer />
  </body>
</html>
