---
import Hero from '../components/Hero.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';

const title = 'Phil Lyons | Commercial Photographer & Filmmaker';
---

<html lang="en">
  <head>
    <title>{title}</title>
    <meta name="description" content="Commercial photography and filmmaking for organisations that want to communicate clearly and authentically." />
  </head>
  <body>
    <Hero />
    <main>
      <FeaturedWork />
      <PortfolioGrid />
    </main>
  </body>
</html>
